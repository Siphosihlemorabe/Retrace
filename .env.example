# Copy to .env and fill in. Never commit .env.

PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/retrace

# Where clones are cached. Disposable — deleting it costs a re-clone, nothing more.
REPO_CACHE_DIR=./var/repos

# --- GitHub App (dev instance) -------------------------------------------------
# Settings > Developer settings > GitHub Apps. Needs: Contents (read),
# Metadata (read), and the `push` webhook event.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Must match the secret set on the App. Every webhook signature is verified
# against this before the payload is parsed.
GITHUB_WEBHOOK_SECRET=

# User-to-server OAuth, for sign-in. Same App.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Sessions ------------------------------------------------------------------
# Random 32+ bytes. `openssl rand -base64 32`
SESSION_SECRET=

# --- LLM -----------------------------------------------------------------------
ANTHROPIC_API_KEY=
